// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id
  email    String? @unique
  name     String?
  emailVerified Boolean @default(false)
  image    String?
  // Access control — owner approves new sign-ups
  role     String @default("user")    // 'owner' | 'admin' | 'user'
  status   String @default("pending")  // 'pending' | 'approved' | 'rejected'
  trades   Trade[]
  learningFeedback LearningFeedback[]
  learningRules    LearningRule[]
  learningMetrics  LearningMetrics?
  chartSettings String?
  layouts     ChartLayout[]
  annotations ChartAnnotation[]
  watchlists  ChartWatchlist[]
  templates   ChartTemplate[]
  sharedItems  SharedItem[]
  sharedItemLikes SharedItemLike[]
  chartUserSettings ChartUserSettings?
  sessions    Session[]
  accounts    Account[]

  // Pattern corpus — pre-trade scan hits classified into the playbook
  corpusRows  CorpusRow[]
  corpusViews CorpusView[]
  corpusTrades CorpusTrade[]
  playbooks   Playbook[]
  playbookTrades PlaybookTrade[]
  corpusDatabases CorpusDatabase[]

  // Journal — folders + content items (entries/notes/strategies)
  folders      Folder[]
  contentItems ContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Pattern Corpus — the /database page backbone
// A CorpusRow is ONE scan hit, human-classified into the playbook
// before any trade is taken. Distinct from Trade (executed P&L).
// ─────────────────────────────────────────────────────────────
model CorpusDatabase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String

  rows      CorpusRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, name])
}

model CorpusRow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  databaseId String?
  database  CorpusDatabase? @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  // Deduped: ONE row per symbol+signalDate. Tracks every scan that hit it.
  scanSources String[] @default([])  // e.g. ['Backside B', 'Short FBO 2']

  // The instrument + the day the setup formed
  symbol    String
  signalDate String

  // Raw scan metrics — flexible JSON (varies per scan type)
  metrics   Json?

  // Human classification layer (strings, not enums — your vocabulary evolves)
  setupType String?  // 'D1' | 'FRD' | 'Backside' | top-level bucket
  setup     String?  // finer: 'FRD-ET-2leg', 'Backside-Cont', etc.
  grade     String?  // 'A+' | 'A' | 'B' | null (ungraded)
  move      String?  // manual link: scans sharing a move name = one cycle
  tags      String[] @default([])

  // Workspace per row (the row-is-a-page model)
  notes        String?  // rich text (BlockNote/Tiptap content)
  annotations  Json?    // [{type:'lab', ref:'uploads/lab-xxx.png', caption?}]

  // Lifecycle
  status    String   @default("new") // 'new' | 'classified' | 'archived'

  // User-defined custom columns (forward testing) — { fieldId: value }
  customValues Json?

  // Trades logged against this setup (0..N)
  trades     CorpusTrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([signalDate])
  @@index([grade])
  @@index([move])
  @@index([databaseId])
  @@unique([databaseId, symbol, signalDate])
}

model CorpusField {
  id        String   @id @default(cuid())
  userId    String

  name      String
  type      String   // 'text' | 'number' | 'select' | 'multiselect' | 'boolean' | 'date' | 'grade'
  options   String[] @default([])  // for select/multiselect
  colors    Json?    // { optionLabel: '#hex' } per-option color for select/multiselect/grade
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Managed option lists — user-editable taxonomies (Setup Type, Setup, etc.)
// Seeded from defaults on first access. options = [{ label: string, color?: string }]
model CorpusEnum {
  id        String   @id @default(cuid())
  userId    String
  key       String   // 'setupType' | 'setup' | 'grade'
  options   Json     // [{label, color?}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ── Trades logged against a CorpusRow setup (forward-testing / execution) ──
// A trade is one way to play the setup. PnL computed from entry/exit/size/dir.
model CorpusTrade {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupRowId String   // → CorpusRow.id
  setupRow   CorpusRow @relation(fields: [setupRowId], references: [id], onDelete: Cascade)

  direction  String   // 'short' | 'long'
  setup     String?  // per-trade setup (inherits parent row.setup if unset; override here)
  routeStart String?  // user-defined: where the route starts (custom enum)
  routeEnd   String?  // user-defined: where the route ends (custom enum)
  entryPrice Float?
  exitPrice  Float?
  qty        Int?
  trendStage String?  // where in the cycle: Euphoric Top / Trendbreak / Backside / ...
  grade      String?  // A+ | A | B — trade grade (reuses grade enum colors)
  sections   Json?    // { htf:{text,annots[]}, mtf:{...}, ltf:{...}, key:{...} } — multi-timeframe context + key points
  notes      String?
  date       String?  // trade date (may differ from scan signalDate)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([setupRowId])
}
model CorpusView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      String   // 'table' | 'board' | 'gallery'
  filters   Json?    // saved filter set
  groupBy   String?  // board grouping: 'setupType' | 'grade' | 'scanSource'
  sortBy    Json?
  hidden    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Playbook — strategy definitions (the blueprint, pre-scan).
// A rich document you hand to Renata before we build the scan.
// Mirrors the corpus TRADE_SECTIONS pattern: text + pasted image
// annotations stored inline as base64 data URLs.
// ─────────────────────────────────────────────────────────────
model Playbook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  status    String   @default("idea") // idea | spec | scan-built | validated | live
  thesis    String?  // one-liner — the edge in a sentence

  // The document — keyed sections, each { text, annots: [{ref, caption?}] }
  sections  Json?

  setupType String?  // optional: link to your setup vocabulary
  tags      String[] @default([])
  grade     String?  // A+ | A | B — confidence in the edge
  category  String?  // optional grouping label — tree parent in the sidebar

  // Example trades logged against this playbook (0..N)
  trades    PlaybookTrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// PlaybookTrade — an example play logged against a strategy.
// Mirrors CorpusTrade's structure but stands alone (carries its own symbol
// since there's no parent row). Used to log textbook instances of a setup.
// ─────────────────────────────────────────────────────────────
model PlaybookTrade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbookId String
  playbook  Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  symbol    String   // the ticker — playbook trades carry their own
  direction String   // 'short' | 'long'
  date      String?  // trade date
  entryPrice Float?
  exitPrice  Float?
  qty       Int?
  grade     String?  // A+ | A | B — example grade
  trendStage String? // where in the cycle
  routeStart String? // user-defined route start
  routeEnd   String?  // user-defined route end
  sections   Json?    // { daily, htf, mtf, ltf } — { text, annots[] }
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([playbookId])
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core trade data
  date         String
  symbol       String
  side         String   // 'Long' | 'Short'
  quantity     Float
  entryPrice   Float
  exitPrice    Float
  pnl          Float
  grossPnl     Float?
  pnlPercent   Float
  commission   Float
  duration     String
  strategy     String
  notes        String
  entryTime    String
  exitTime     String

  // Optional risk management fields
  riskAmount   Float?
  riskPercent  Float?
  stopLoss     Float?
  rMultiple    Float?
  mfe          Float?
  mae          Float?

  // Metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Journal — folders + content items (trade entries, notes, strategies)
// Backs the /journal page. A flat folder tree per user; content items
// (the actual journal entries) live inside folders.
// ─────────────────────────────────────────────────────────────
model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?  // null = root. Self-referential tree.
  parent    Folder?  @relation("FolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderParent")

  name      String
  icon      String   @default("folder")
  color     String   @default("#888")
  position  Int      @default(0)

  contentItems ContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentId])
}

model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // 'trade_entry' | 'document' | 'note' | 'strategy' | 'research' | 'review'
  type      String   @default("note")
  title     String
  content   Json?
  metadata  Json?
  tags      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([folderId])
  @@index([type])
}

// Learning System Models
model LearningFeedback {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId        String   // Frontend message ID for reference
  feedbackType     String   // 'positive', 'correction', 'clarification'
  originalMessage  String   // Original user message
  correctedMessage String?  // User's correction (if applicable)
  userContext      String?  // Additional context provided
  confidence       Float    @default(1.0)

  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([feedbackType])
}

model LearningRule {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalMessage  String   // Original message that triggered learning
  correctedMessage String   // User's preferred response/action
  ruleDescription  String   // Human-readable rule description
  ruleType         String   // 'correction', 'preference', 'context'
  context          String?  // Specific context for rule application
  priority         Int      @default(1) // Rule priority (higher = more important)
  isGlobalRule     Boolean  @default(false) // Apply to all users vs user-specific
  patterns         String   // JSON string of extracted patterns
  isActive         Boolean  @default(true)
  confidence       Float    @default(1.0)
  timesApplied     Int      @default(0)

  createdAt        DateTime @default(now())
  lastUsed         DateTime?

  @@index([userId])
  @@index([ruleType])
  @@index([isActive])
}

model LearningMetrics {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalFeedback         Int      @default(0)
  understandingAccuracy Float    @default(0.8)
  totalCorrections      Int      @default(0)
  isActive              Boolean  @default(true)

  createdAt             DateTime? @default(now())
  lastUpdated           DateTime @updatedAt

  @@index([userId])
}

// ── Chart Data Models ──

model ChartLayout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("default")
  tools     String   @default("[]")          // JSON array of tool instances
  preset    String?                           // active preset name
  presetIndCustoms String? @default("{}")    // JSON per-preset custom params/colors
  chartSettings String? @default("{}")       // JSON font scale, chart style, theme
  chartStyle    String? @default("{}")       // JSON bar color overrides
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChartAnnotation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  data      String   @default("[]")          // JSON array of annotation objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model ChartWatchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("default")
  symbols   String   @default("[]")          // JSON array of symbol strings
  columns   String?  @default("{}")          // JSON column config
  meta      String?  @default("{}")          // JSON: { "SYM": { "note": "..." } }
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChartTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("template")    // 'template' (layout: indicators only) | 'savedchart' (full snapshot: symbol+tf+indicators)
  tools     String   @default("[]")          // JSON snapshot: full ChartTemplate payload (tools/inds/colors/params/chartStyle/symbol/tf)
  global    Boolean  @default(false)         // visible to ALL pages/users (no auth) — local single-user store
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([global])
}

model ChartUserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawDefaults      String? @default("{}")     // JSON annotation tool defaults
  toolbarPosition   String? @default("{}")     // JSON toolbar pos
  theme             String? @default("dark")   // 'dark' | 'light'
  themeColors       String? @default("{}")     // JSON custom theme overrides
  trackpadSettings  String? @default("{}")     // JSON trackpad config
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ── better-auth tables ──

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Community Sharing ──

model SharedItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "template" | "scan" | "layout"
  sourceId    String   // ID of the source template/scan/layout
  slug        String   @unique  // short URL-safe slug (nanoid 8 chars)
  name        String   // display name at time of sharing
  description String?  // optional user description
  data        String   @default("{}")  // JSON snapshot of the shared item
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       SharedItemLike[]

  @@index([slug])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([likeCount])
}

model SharedItemLike {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedItemId String
  sharedItem   SharedItem @relation(fields: [sharedItemId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, sharedItemId])
  @@index([sharedItemId])
}

// ── Saved Scans ──

model SavedScan {
  id            String       @id @default(cuid())
  userId        String?
  name          String
  type          String       @default("imported")  // "builtin" | "code" | "imported"
  strategy      String       @default("custom")     // e.g. "inside_day_long", "backside_b"
  code          String?                             // uploaded JS/Python source
  dateRange     String?                             // JSON { from, to } — last run range
  params        String?                             // JSON — params used for this run (for rerun)
  filterMode    String       @default("3")
  results       String       @default("[]")         // JSON — latest run results (backward compat)
  resultCount   Int          @default(0)            // signals in latest run
  cachedCount   Int          @default(0)            // total accumulated signals
  cachedFrom    String?                             // earliest cached signal date
  cachedTo      String?                             // latest cached signal date
  tags          String       @default("[]")         // JSON array of tag strings
  notes         String?
  isFavorite    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  signals       ScanSignal[]
  scannedDates  ScannedDate[]
  runs          ScanRun[]
  customColumns ScanCustomColumn[]

  @@index([userId])
  @@index([strategy])
  @@index([type])
  @@index([createdAt])
}

// Individual cached signals — accumulates over time across runs
model ScanRun {
  id          String    @id @default(cuid())
  scanId      String
  scan        SavedScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  label       String    // e.g. "Apr 10 – May 08" or "Full Q1 2025"
  dateFrom    String    // "2026-04-10"
  dateTo      String    // "2026-05-08"
  signalCount Int       @default(0)
  status      String    @default("completed") // "running" | "completed" | "failed"
  params      String?   // JSON snapshot of params used for this run
  createdAt   DateTime  @default(now())

  signals     ScanSignal[]

  @@index([scanId])
  @@index([scanId, createdAt])
  @@index([dateFrom, dateTo])
}

model ScanSignal {
  id          String    @id @default(cuid())
  scanId      String
  runId       String?   // nullable for backward compat with pre-run signals
  run         ScanRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  scan        SavedScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ticker      String
  signalDate  String                              // "2026-04-13" — normalized date
  data        String                              // JSON of all signal fields
  createdAt   DateTime  @default(now())

  @@unique([scanId, ticker, signalDate])
  @@index([scanId, signalDate])
  @@index([scanId, ticker])
  @@index([signalDate])
  @@index([runId])
}

// Dates that have been scanned (even if 0 signals found)
model ScannedDate {
  id        String    @id @default(cuid())
  scanId    String
  scan      SavedScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  date      String    // "2026-04-13" — trading date that was scanned
  createdAt DateTime  @default(now())

  @@unique([scanId, date])
  @@index([scanId])
  @@index([date])
}

// Custom computed columns per scan
model ScanCustomColumn {
  id        String    @id @default(cuid())
  scanId    String
  scan      SavedScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name      String    // display name, e.g. "Risk/Reward"
  key       String    // column key, e.g. "risk_reward"
  formula   String    // JS expression, e.g. "(row.target_price - row.entry_price) / (row.entry_price - row.stop_price)"
  format    String?   // "percent" | "money" | "number" | "ratio"
  colorExpr String?   // JS expression for color, e.g. "val > 2 ? '#4ade80' : val > 1 ? '#fbbf24' : '#f87171'"
  order     Int       @default(0) // sort order in column list
  isDefault Boolean   @default(false) // shown on new scans by default?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scanId, key])
  @@index([scanId])
}

// ── Strategy Lab ──

model StrategyProject {
  id            String          @id @default(cuid())
  userId        String?
  name          String
  description   String?
  type          String          @default("setup")   // "scan" | "setup" | "strategy"
  status        String          @default("idea")     // "idea" | "developing" | "testing" | "validated" | "retired"
  tags          String          @default("[]")       // JSON array of tag strings
  linkedScanId  String?                               // link to a SavedScan
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  phases        ProjectPhase[]
  entries       ProjectEntry[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model ProjectPhase {
  id        String         @id @default(cuid())
  projectId String
  project   StrategyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     String                              // "scan" | "setup" | "entry" | "exit" | "backtest"
  label     String?                             // override label e.g. "Gap Fade" instead of "Entry"
  order     Int            @default(0)
  entries   ProjectEntry[]

  @@unique([projectId, phase])
  @@index([projectId])
}

model ProjectEntry {
  id        String         @id @default(cuid())
  projectId String
  project   StrategyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     ProjectPhase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parentId  String?                              // for threaded comments / nested entries
  type      String                              // "screenshot" | "note" | "idea" | "comment" | "scan_result" | "backtest_result"
  title     String?
  body      String?                              // markdown text / note content
  imageData String?                             // base64 data URL of chart screenshot
  meta      String?                             // JSON: ticker, date, annotations config, etc.
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([parentId])
  @@index([type])
  @@index([createdAt])
}


model BtKV {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Dilution Radar — free-SEC dilution terminal (replaces paid AskEdgar)
// Spec: edge-dev assets/dilution/SPEC.md
// ─────────────────────────────────────────────────────────────────────────

// Ticker ↔ CIK map cache (hydrated from sec.gov/files/company_tickers_exchange.json)
model SecTickerCik {
  ticker    String   @id            // uppercase, share-class hyphenated (BRK-B)
  cik       String                  // 10-digit zero-padded SEC CIK
  name      String
  exchange  String?
  fetchedAt DateTime @default(now())

  @@index([cik])
}

model DilutionCompany {
  cik               String   @id            // 10-digit zero-padded SEC CIK
  tickers           String[]                // native array: current + historical tickers
  name              String
  sicCode           String?
  exchange          String?
  entityType        String?
  firstFetched      DateTime @default(now())
  filingsLastSynced DateTime?
  factsLastSynced   DateTime?
  filings           DilutionFiling[]
  form4Txns         DilutionForm4Txn[]
  facts             DilutionFact[]
  securities        DilutionSecurity[]
}

model DilutionSecurity {
  // Warrant + convertible overhang (extracted from XBRL companyfacts).
  // One aggregate row per cik per type: the LATEST reported strike + share
  // count. Price-dependent in-the-money scoring is layered on later (needs a
  // real-time price feed); the overhang % alone is a far stronger offeringRisk
  // signal than the filing-count proxy.
  id              String   @id @default(cuid())
  cik             String
  company         DilutionCompany @relation(fields: [cik], references: [cik], onDelete: Cascade)
  type            String   // 'warrant' | 'convertible' | 'prefunded'
  strike          Float?   // exercise/conversion price (USD/share), latest reported
  shares          Float?   // warrants / underlying shares outstanding (latest reported)
  period          String?  // reporting period (YYYY-MM-DD) of the latest data
  accn            String?
  syncedAt        DateTime @default(now())

  @@unique([cik, type])
  @@index([cik])
}

model DilutionFiling {
  accessionNo  String   @id                 // globally unique → idempotent upsert
  cik          String
  company      DilutionCompany @relation(fields: [cik], references: [cik], onDelete: Cascade)
  formType     String                       // S-1, S-3, 424B5, 8-K, 4, 425...
  filingDate   DateTime
  reportDate   DateTime?
  primaryDoc   String?
  primaryDesc  String?
  items        String[]                     // 8-K items ["1.01","5.03","3.03"]
  dilutionTags String[] @default([])        // ["shelf","atm","convertible","equity-line","reverse-split","warrant","delisting-risk"]
  rawPayload   Json?                        // full raw row for debug/replay
  createdAt    DateTime @default(now())

  @@index([cik, filingDate])
  @@index([formType, filingDate])
}

model DilutionFact {
  cik     String
  company DilutionCompany @relation(fields: [cik], references: [cik], onDelete: Cascade)
  fact    String   // EntityCommonStockSharesOutstanding | EntityPublicFloat | ...
  period  String   // "end" date, e.g. "2026-04-17"
  unit    String   // "shares" | "USD"
  val     Float
  filed   DateTime?
  accn    String?

  @@id([cik, fact, period])
  @@index([cik, fact])
}

model DilutionForm4Txn {
  id          String   @id @default(cuid())
  cik         String
  company     DilutionCompany @relation(fields: [cik], references: [cik], onDelete: Cascade)
  reporter    String
  reporterCik String?
  isOfficer   Boolean  @default(false)
  txnCode     String   // P=buy S=sell A=award G=gift M=exempt...
  securities  Float    @default(0)
  price       Float?
  afterShares Float?
  txnDate     DateTime
  createdAt   DateTime @default(now())

  @@index([cik, txnDate])
}

// Historical research report store — UNIFIED for backlogged AskEdgar ground-truth
// reports AND our own computed snapshots. `source` distinguishes provenance so we
// can side-by-side compare and migrate off AskEdgar. Idempotent: id="ae-<csvId>"
// for imports, cuid for our runs.
model DilutionReport {
  id                String   @id
  ticker            String
  reportDate        DateTime
  source            String   // "askedgar" | "traderra"
  sourceRef         String?  // discord_message_id | our run id
  price             Float?
  marketCap         Float?
  floatShares       BigInt?
  outstandingShares BigInt?
  gainPercent       Float?
  industry          String?
  // Risk labels (low/medium/high) — the clone target
  cashBurnRisk      String?
  dilutionRisk      String?
  offeringRisk      String?
  scamRisk          String?
  rawText           String   @db.Text
  parsedJson        Json
  importedAt        DateTime @default(now())

  @@index([ticker, reportDate])
  @@index([source])
}

// Plain-string userId/cik (no FK) — keeps User model untouched; allows watch before full ingest
model DilutionWatch {
  userId    String
  cik       String
  ticker    String
  addedAt   DateTime @default(now())
  lastAlert DateTime?

  @@id([userId, cik])
  @@index([userId])
  @@index([cik])
}

model DilutionScanRun {
  id        String   @id @default(cuid())
  scanType  String   // equity-line | atm | convertible | shelf-effective | reverse-split
  query     String
  ranAt     DateTime @default(now())
  hitCount  Int      @default(0)
  hits      DilutionScanHit[]

  @@index([scanType, ranAt])
}

model DilutionScanHit {
  id          String   @id @default(cuid())
  scanRunId   String
  scanRun     DilutionScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  cik         String
  ticker      String?
  formType    String
  filingDate  DateTime
  accessionNo String
  snippet     String?
  score       Float?
  createdAt   DateTime @default(now())

  @@index([scanRunId])
  @@index([cik])
  @@index([filingDate])
}

// ── Backtest annotations: notes + pasted/lab images + tags per signal ──
// Manual flow: user annotates a screenshot in /lab OR pastes a screenshot directly
// into the annotation modal (Ctrl+V). Images upload via /api/lab/save.
// The agent reads `note` (text); the image is the user's visual aid / reference.
// Tags carry strategy/scan/run context (denormalized `strategy`) for organization.
model BacktestAnnotation {
  id          String   @id @default(cuid())
  scanId      String   // SavedScan id
  strategy    String?  // denormalized: strategy of the parent scan (for tag organization)
  ticker      String
  signalDate  String   // YYYY-MM-DD of the signal
  note        String   @default("")
  images      String[] // filenames from /api/lab/save, e.g. lab-1782...png (pasted or lab)
  tags        String[] // multiple tags, custom + presets (HELD / CRAP / PUSH-FAIL / WATCH ...)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scanId, ticker, signalDate])
  @@index([scanId])
  @@index([ticker])
  @@index([strategy])
}
